# ============================================================
# Sistema Pessoal Yuri — variáveis de ambiente
# Copie para `.env.local` e preencha com as chaves do SEU projeto Supabase.
# NÃO commite o `.env.local`.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Somente servidor — nunca exponha no frontend (não use prefixo NEXT_PUBLIC_)
# (Fase 13) Necessária para o Vercel Cron gerar notificações (a rota roda sem sessão
# de usuário e usa a service role, sempre filtrando user_id explicitamente). Sem ela,
# a rota de Cron degrada para no-op; a busca, o sino e o lançamento rápido funcionam normalmente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# (Fase 13) Segredo do Vercel Cron — protege /api/cron/notifications. O Vercel Cron
# envia automaticamente `Authorization: Bearer ${CRON_SECRET}`. Gere um valor aleatório
# (ex.: `openssl rand -hex 32`). Sem ele, a rota responde 401 (não fica pública).
CRON_SECRET=um-segredo-aleatorio-forte

# (Fase 08) Google Agenda — OAuth (SOMENTE servidor — nunca use prefixo NEXT_PUBLIC_)
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# (OAuth client ID, tipo "Web application"). Habilite a "Google Calendar API".
# Em "Authorized redirect URIs" adicione: http://localhost:3000/api/google/callback
# (e a URL equivalente de produção). A agenda local funciona SEM estas chaves;
# o botão "Conectar Google Agenda" só fica ativo quando ambas existem.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Opcional: sobrescreve a redirect URI (senão é derivada da origem da requisição)
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# (Fase 18-A) Inteligência Artificial — chaves-mestras do envelope de criptografia.
# SOMENTE SERVIDOR. Nunca use prefixo NEXT_PUBLIC_. Nunca commite valores reais.
#
# As chaves de API dos provedores (OpenAI/Gemini/Anthropic/xAI) são guardadas CIFRADAS
# no banco (AES-256-GCM com envelope: uma DEK por credencial, embrulhada por estas
# chaves-mestras). A master key vive só no ambiente do servidor — nunca no banco.
#
# Formato: "<versao>:<base64 de EXATAMENTE 32 bytes>,<versao>:<base64 de 32 bytes>"
# Gere cada uma com:  openssl rand -base64 32
# Duas versões coexistem só durante a rotação; AI_MASTER_KEY_CURRENT diz qual CIFRA agora.
#
# Sem elas o resto do sistema funciona normalmente — apenas /ia fica indisponível
# (fail-closed só para IA). Chave curta NÃO é completada com padding, senha humana NÃO
# vira master key e versão ausente NÃO é escolhida em silêncio.
# AI_MASTER_KEYS=1:chave-base64-de-32-bytes
# AI_MASTER_KEY_CURRENT=1
